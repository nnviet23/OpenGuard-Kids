# Sao chép thành .env. Mọi biến có tiền tố OGK_.
OGK_ENV=dev
# Khóa chủ >= 32 ký tự ngẫu nhiên; từ đó dẫn xuất (HKDF) khóa ký chính sách, JWT, mã hóa trường nhạy cảm.
# Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ở môi trường dev có thể để trống: server tự sinh data/.dev_master_key. Ở prod BẮT BUỘC đặt.
OGK_MASTER_KEY=
OGK_DATABASE_URL=sqlite:///./data/ogk_server.db
OGK_COOKIE_SECURE=false
OGK_SEED_DEMO=true
OGK_RETENTION_DAYS=90
OGK_POLICY_VALID_DAYS=7
